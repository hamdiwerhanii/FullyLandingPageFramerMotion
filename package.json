{
  "name": "learning-app-landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Animated landing page for a mobile learning app, built with Next.js, TypeScript, Tailwind CSS and Framer Motion.",
  "author": "Hamdi Werhani (https://github.com/hamdiwerhanii)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config=vitest.unit.config.mts",
    "test:unit": "vitest run --config=vitest.unit.config.mts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
